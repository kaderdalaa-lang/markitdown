# Copy to .env.local and fill in. Never commit .env.local.
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used in confirmation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend: API keys page. EMAIL_FROM must be on a domain you have verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Shared secret for /api/jobs/send-email. Generate with: openssl rand -hex 32
JOB_SECRET=
